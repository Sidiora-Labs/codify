# Test workflow for the cg spec engine.

[meta]
name            = "Demo Spec Workflow"
active_feature  = "demo"
source_of_truth = "spec/ (kvx). Generated files are pointers — regenerate, never hand-edit."

[principle]
task_driven = "Work is driven by the active feature's task list."
one_in_progress = "At most one task is in_progress at a time."

[loop]
step_1 = "Read the active spec.kvx."
step_2 = "Pick the next eligible task by wave."
step_3 = "Implement, verify, mark done."

[memory]
recall = "Load relevant context at session start."
remember = "Persist durable decisions as they occur."

[status_values]
task = ["pending", "in_progress", "done"]

[hard_rules]
no_fakes = "Never fake a test to make it pass."
no_git = "The user drives commits."

[render]
markdown_mirror = true
mirror_to_kiro  = false
banner = "GENERATED by cg spec render from spec/ kvx — DO NOT EDIT."

[adapters]
claude = "CLAUDE.md"
cursor = ".cursor/rules/spec-workflow.mdc"
